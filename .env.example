# Pulsar Hub environment: PLACEHOLDERS ONLY. Copy to .env and fill in. NEVER commit .env.
# Every variable hub/settings.py reads is listed here (CLAUDE.md rule 6). Keep comments on their
# own lines: Docker Compose and django-environ treat a trailing "# ..." differently.

# ─── PostgreSQL (compose) ─────────────────────────────────────────────────────
# Database superuser name, created on first start of the db container.
POSTGRES_USER=hub
# Database password. Use a hex value (`openssl rand -hex 24`) so it is safe inside a URL.
POSTGRES_PASSWORD=change-me
# Database name.
POSTGRES_DB=hub

# ─── Django core ──────────────────────────────────────────────────────────────
# Signing key for sessions and tokens. Long and random: `python -c "import secrets; print(secrets.token_urlsafe(50))"`.
DJANGO_SECRET_KEY=change-me-long-random
# Never true in production. True also lets the hub start without an OIDC key (development only).
DJANGO_DEBUG=false
# Comma-separated host names the hub answers to.
DJANGO_ALLOWED_HOSTS=hub.example.com
# Public address of the hub, no trailing slash. It is the OIDC issuer and the base of emailed links.
HUB_BASE_URL=https://hub.example.com
# Display name used in emails, the MFA issuer and page titles.
PRODUCT_NAME=Pulsar Hub
# Comma-separated origins (with scheme) trusted for CSRF, normally the same as HUB_BASE_URL.
CSRF_TRUSTED_ORIGINS=https://hub.example.com

# ─── Database (outside compose only) ──────────────────────────────────────────
# Compose builds DATABASE_URL from POSTGRES_* above. Set it only to run manage.py or pytest on
# your own machine against a database you started yourself.
# DATABASE_URL=postgres://hub:change-me@127.0.0.1:5432/hub
# Seconds a database connection is kept open between requests.
DATABASE_CONN_MAX_AGE=60

# ─── Proxy, cookies and sessions ──────────────────────────────────────────────
# Number of reverse proxies in front of the hub (Caddy = 1). Used to trust X-Forwarded-For.
NUM_PROXIES=1
# True only for plain-HTTP local development (disables Secure cookies). Never in production.
INSECURE_COOKIES=false
# HSTS max-age in seconds, applied only when cookies are secure.
SECURE_HSTS_SECONDS=31536000
# Absolute session lifetime in hours.
SESSION_MAX_AGE_HOURS=12
# Seconds a fresh MFA check counts as "recent" for step-up actions.
MFA_STEP_UP_MAX_AGE_SECONDS=300

# ─── OIDC provider (the hub signs tokens for TIM2 and the app) ────────────────
# RSA private key that signs ID tokens. REQUIRED when DJANGO_DEBUG is false.
# Generate it with `python manage.py generate_oidc_key` (prints a PEM). A PEM has many lines, so
# put it on ONE line in single quotes with a literal backslash-n between lines:
#   OIDC_RSA_PRIVATE_KEY='-----BEGIN PRIVATE KEY-----\nMIIEv...\n...\n-----END PRIVATE KEY-----'
# Never commit the real value. Keep it in a secret store and rotate it with the setting below.
OIDC_RSA_PRIVATE_KEY=
# Previous key(s), still published for verification after a rotation. Separate multiple PEMs with
# a blank line, i.e. a double backslash-n (\n\n), in the same one-line single-quoted form.
OIDC_RSA_PRIVATE_KEYS_INACTIVE=
# Comma-separated redirect URI schemes clients may register (add the app's scheme, e.g. pulsarapp).
OIDC_ALLOWED_REDIRECT_URI_SCHEMES=https
# Access and ID token lifetime in seconds.
OIDC_ACCESS_TOKEN_SECONDS=600
# Refresh token lifetime in days.
OIDC_REFRESH_TOKEN_DAYS=30

# ─── Sign in with Microsoft Entra and Google ──────────────────────────────────
# Leave blank to disable a provider. One multi-tenant application per provider.
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─── Organisations and invitations ────────────────────────────────────────────
# Days an invitation link stays valid.
INVITATION_EXPIRY_DAYS=7
# Maximum hours a Pulsar operator may hold access to an organisation before it is granted again.
OPERATOR_ACCESS_MAX_HOURS=8

# ─── API ──────────────────────────────────────────────────────────────────────
# Throttle for unauthenticated API requests.
API_THROTTLE_ANON=30/min
# Throttle for authenticated API requests.
API_THROTTLE_USER=600/min

# ─── Web server and worker ────────────────────────────────────────────────────
# Gunicorn worker processes in the web container.
GUNICORN_WORKERS=2
# Gunicorn request timeout in seconds.
GUNICORN_TIMEOUT=30
# django-q2 worker processes in the worker container.
Q_CLUSTER_WORKERS=2
# Seconds before a background task is killed.
Q_CLUSTER_TIMEOUT=60
# Seconds before an unacknowledged task is retried (must exceed Q_CLUSTER_TIMEOUT).
Q_CLUSTER_RETRY=120

# ─── Email ────────────────────────────────────────────────────────────────────
# Django email backend. The default prints emails to the log; use the SMTP backend in production.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# SMTP server host name.
EMAIL_HOST=smtp.example.com
# SMTP port.
EMAIL_PORT=587
# SMTP user name.
EMAIL_HOST_USER=change-me
# SMTP password.
EMAIL_HOST_PASSWORD=change-me
# Use STARTTLS.
EMAIL_USE_TLS=true
# From address for emails sent by the hub (also the address for error emails).
DEFAULT_FROM_EMAIL=hub@example.com

# ─── Logging and error monitoring ─────────────────────────────────────────────
# debug, info, warning or error.
LOG_LEVEL=info
# json in production, text for reading in a terminal.
LOG_FORMAT=json
# Sentry DSN. Blank = nothing is sent anywhere.
SENTRY_DSN=
# Environment tag sent with errors.
SENTRY_ENVIRONMENT=production
# Release identifier sent with errors (for example the commit SHA).
HUB_RELEASE=

# ─── Production deployment (docker-compose.prod.yml) ──────────────────────────
# Registry path of the published image, without a tag.
HUB_IMAGE=ghcr.io/example/pulsar-hub
# Image tag; pin a commit SHA for change control.
HUB_IMAGE_TAG=latest
# Public domain Caddy gets a certificate for (must match HUB_BASE_URL and DJANGO_ALLOWED_HOSTS).
HUB_DOMAIN=hub.example.com
# Email address for Let's Encrypt expiry notices.
ACME_EMAIL=ops@example.com
